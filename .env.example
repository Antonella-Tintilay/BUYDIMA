
# Nombre de la aplicación (aparece en los títulos dinámicos y el pie de página)
APP_NAME=BUYDIMA

# Correo del equipo de soporte (se muestra en la página de contacto)
SUPPORT_EMAIL=soporte@buydima.com

# Entorno de ejecución: local | produccion
APP_ENV=local

# Conexión a MySQL (completar en .env; no subir credenciales reales)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=buydima
DB_USER=root
DB_PASSWORD=
